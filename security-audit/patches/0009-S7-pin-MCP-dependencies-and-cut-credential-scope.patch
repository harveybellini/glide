+args = [
+    "run", "-i", "--rm",
+    "-e", "AWS_PROFILE", "-e", "AWS_REGION",
+    "-v", "<USER_HOME>/.aws:/app/.aws:ro",
+    "public.ecr.aws/awslabs-mcp/awslabs/cloudwatch-mcp-server@sha256:477bfd0885228340a0979ddabcca13f4e7df0fce39cbb128bf7cfa21318de62a",
