+# Project-scoped MCP servers for Glide (trusted project).
+# STAGED COPY: scripts/install-mcps.ps1 renders this into .codex/config.toml,
+# substituting <REPO_ROOT> and <USER_HOME>. Only mcp_servers are defined here;
+# this layer merges over ~/.codex/config.toml.
+# See docs/mcp-setup.md for install, credentials, and verification.
+#
+# Supply-chain rules for this file:
+# - npm servers are pinned to exact versions and their lockfiles are committed.
+# - container images are pinned by digest; never reference a mutable tag.
+# - servers default to approval mode "writes".
+
+# --- Playwright (browser automation) ---
+# Install: cd tools/mcp/playwright && npm install
+[mcp_servers.playwright]
+command = "node"
+args = ["<REPO_ROOT>/tools/mcp/playwright/launch.mjs"]
+enabled = true
+required = false
+startup_timeout_sec = 30
+default_tools_approval_mode = "writes"
+
+# High-risk browser tools always prompt, whatever the default is.
+[mcp_servers.playwright.tools.browser_navigate]
+approval_mode = "approve"
