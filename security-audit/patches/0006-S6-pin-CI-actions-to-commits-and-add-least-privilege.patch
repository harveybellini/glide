From a10ea304dfc257a5f020290d846945c1d871a9c8 Mon Sep 17 00:00:00 2001
From: Harvey Bellini <harveybellini@gmail.com>
Date: Fri, 11 Sep 2026 19:26:36 +0100
Subject: [PATCH 06/11] S6: pin CI actions to commits and add least-privilege
 permissions

All three workflows used mutable major tags with the default token scope. Every action is pinned to the commit behind v4.4.0/v5.4.2 (verified against the upstream repositories), the workflow declares contents: read, a test enforces both invariants, and Dependabot keeps the pins current.
---
 .github/dependabot.yml             | 13 +++++++++
 .github/workflows/ci.yml           | 19 ++++++++-----
 tests/unit/test_ci_supply_chain.py | 43 ++++++++++++++++++++++++++++++
 3 files changed, 68 insertions(+), 7 deletions(-)
 create mode 100644 .github/dependabot.yml
 create mode 100644 tests/unit/test_ci_supply_chain.py

diff --git a/.github/dependabot.yml b/.github/dependabot.yml
new file mode 100644
index 0000000..bcc7942
--- /dev/null
+++ b/.github/dependabot.yml
@@ -0,0 +1,13 @@
+version: 2
+
+updates:
+  # CI pins actions to commit SHAs; Dependabot keeps those pins current.
+  - package-ecosystem: github-actions
+    directory: "/"
+    schedule:
+      interval: weekly
+
+  - package-ecosystem: npm
+    directory: "/frontend"
+    schedule:
+      interval: weekly
diff --git a/.github/workflows/ci.yml b/.github/workflows/ci.yml
index 3deaf1c..9ed3b01 100644
--- a/.github/workflows/ci.yml
+++ b/.github/workflows/ci.yml
@@ -4,12 +4,17 @@ on:
   push:
   pull_request:
 
+# Least privilege: the workflow only reads the repository. Commits are pinned
+# so a compromised or re-tagged upstream action cannot change what CI runs.
+permissions:
+  contents: read
+
 jobs:
   backend:
     runs-on: ubuntu-latest
     steps:
-      - uses: actions/checkout@v4
-      - uses: astral-sh/setup-uv@v5
+      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4.4.0
+      - uses: astral-sh/setup-uv@d4b2f3b6ecc6e67c4457f6d3e41ec42d3d0fcb86 # v5.4.2
         with:
           python-version: "3.12"
       - run: uv sync --frozen
@@ -23,8 +28,8 @@ jobs:
       run:
         working-directory: frontend
     steps:
-      - uses: actions/checkout@v4
-      - uses: actions/setup-node@v4
+      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4.4.0
+      - uses: actions/setup-node@49933ea5288caeca8642d1e84afbd3f7d6820020 # v4.4.0
         with:
           node-version: 22
           cache: npm
@@ -36,11 +41,11 @@ jobs:
   e2e:
     runs-on: ubuntu-latest
     steps:
-      - uses: actions/checkout@v4
-      - uses: astral-sh/setup-uv@v5
+      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4.4.0
+      - uses: astral-sh/setup-uv@d4b2f3b6ecc6e67c4457f6d3e41ec42d3d0fcb86 # v5.4.2
         with:
           python-version: "3.12"
-      - uses: actions/setup-node@v4
+      - uses: actions/setup-node@49933ea5288caeca8642d1e84afbd3f7d6820020 # v4.4.0
         with:
           node-version: 22
           cache: npm
diff --git a/tests/unit/test_ci_supply_chain.py b/tests/unit/test_ci_supply_chain.py
new file mode 100644
index 0000000..3e81dce
--- /dev/null
+++ b/tests/unit/test_ci_supply_chain.py
@@ -0,0 +1,43 @@
+"""S6: CI actions are pinned to commits and run with least privilege."""
+
+from __future__ import annotations
+
+import re
+from pathlib import Path
+
+import yaml
+
+ROOT = Path(__file__).resolve().parents[2]
+WORKFLOW = ROOT / ".github" / "workflows" / "ci.yml"
+PINNED_ACTION = re.compile(r"^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+@[0-9a-f]{40}$")
+
+
+def _workflow() -> dict:
+    return yaml.safe_load(WORKFLOW.read_text(encoding="utf-8"))
+
+
+def _uses_entries(workflow: dict) -> list[str]:
+    return [
+        step["uses"]
+        for job in workflow["jobs"].values()
+        for step in job.get("steps", [])
+        if "uses" in step
+    ]
+
+
+def test_every_action_is_pinned_to_a_full_commit_sha() -> None:
+    uses = _uses_entries(_workflow())
+
+    assert uses
+    for entry in uses:
+        assert PINNED_ACTION.match(entry), entry
+
+
+def test_workflow_permissions_are_read_only() -> None:
+    workflow = _workflow()
+    permissions = workflow.get("permissions")
+
+    assert permissions, "the workflow must declare explicit permissions"
+    assert "write" not in str(permissions)
+    for job in workflow["jobs"].values():
+        assert "write" not in str(job.get("permissions", ""))
