From 57f1455e56737c3f93d6a75d17b48cdf5423a84c Mon Sep 17 00:00:00 2001
From: Harvey Bellini <harveybellini@gmail.com>
Date: Fri, 11 Sep 2026 19:21:18 +0100
Subject: [PATCH 01/11] S1: never schedule sample tenants and keep demo runs
 off Bedrock

Anonymous POST /api/demo/session created tenants that the 5-minute dispatcher kept re-running on Bedrock for the snapshot lifetime. Sample tenants are now skipped by the deployed dispatcher and the deployed worker runs sample sessions through the deterministic planner, so demo traffic cannot reach Bedrock or Amazon Location.
---
 backend/glide/deploy/dispatcher.py    | 12 +++++---
 backend/glide/deploy/worker.py        | 21 ++++++++++---
 tests/unit/test_deploy_entrypoints.py | 43 +++++++++++++++++++++++++++
 tests/unit/test_dispatcher.py         | 13 ++++----
 4 files changed, 75 insertions(+), 14 deletions(-)

diff --git a/backend/glide/deploy/dispatcher.py b/backend/glide/deploy/dispatcher.py
index 7c9fc7b..137f404 100644
--- a/backend/glide/deploy/dispatcher.py
+++ b/backend/glide/deploy/dispatcher.py
@@ -5,6 +5,12 @@ check per enabled tenant, and relies on FIFO ordering plus the worker's
 ownership checks for safety. It requires settings to be persisted by the API
 routes, which the sample routes now do. The scan is a placeholder for an
 active/due index; page size keeps each invocation bounded meanwhile.
+
+Sample tenants (``sample-*``) are never scheduled. The public demo creates
+those tenants without authentication, so scheduling them would let anonymous
+traffic generate recurring work for up to the 24-hour snapshot lifetime.
+Sample runs still execute on explicit user action through the worker's
+deterministic sample processor.
 """
 
 from __future__ import annotations
@@ -82,10 +88,8 @@ def dispatch_once(
             settings = UserSettings.model_validate_json(item["payload"]["S"])
             if not settings.enabled:
                 continue
-            if (
-                settings.user_id.startswith("sample-")
-                and state_store.get_sample_snapshot(settings.user_id) is None
-            ):
+            if settings.user_id.startswith("sample-"):
+                # F1/S1: anonymous demo tenants must never self-schedule.
                 continue
             run_id = f"run-{uuid.uuid4().hex}"
             state_store.save_run(
