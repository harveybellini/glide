# Local fixture mode needs no provider credentials.
GLIDE_ENV=development
GLIDE_SAMPLE_ONLY=true
# GLIDE_AGENT_MODE=bedrock enables the Strands/Bedrock runner for sample runs;
# deterministic is the default and the fallback when BEDROCK_MODEL_ID is unset.
GLIDE_AGENT_MODE=deterministic

# Optional local-development tuning. The demo API persists sample runs to a
# local SQLite file and processes queued jobs on a background worker.
# GLIDE_LOCAL_DB=glide-local.db
# GLIDE_WORKER_POLL_INTERVAL=1.0
# GLIDE_SCHEDULE_INTERVAL=300.0  # local background scheduler; 0 disables

# Add these only after completing docs/setup.md account configuration.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback
# GLIDE_SESSION_SECRET=
# GLIDE_SECURE_COOKIES=false
# GLIDE_FRONTEND_ORIGIN=http://localhost:5173
# AWS_PROFILE=
# AWS_REGION=
# BEDROCK_MODEL_ID=
# BEDROCK_MAX_TOKENS=
# GLIDE_PLACE_QUERY_ORIGIN=Big Ben, London
# GLIDE_PLACE_QUERY_DESTINATION=The Shard, London

# Decision emails (Amazon SES). Verify the sending identity in the same region
# first; the worker only notifies when GLIDE_NOTIFICATION_FROM is set.
# GLIDE_NOTIFICATION_FROM=glide@example.com
# GLIDE_PUBLIC_BASE_URL=http://localhost:5173
# GLIDE_NOTIFICATION_CONFIGURATION_SET=
